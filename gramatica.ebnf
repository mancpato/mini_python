(* Gramática de MiniPy en EBNF:                                       *)
(*   "x"     terminal literal                                         *)
(*   { x }   cero o más repeticiones de x                             *)
(*   [ x ]   x es opcional                                            *)
(*   ( x )   agrupación                                               *)
(*   a | b   a o b                                                    *)
(*   ...     abrevia un rango de caracteres: "a" | ... | "z"          *)
(* Las reglas se escriben con ::=, como en BNF.                       *)
(* Este archivo es la referencia oficial del lenguaje: el analizador  *)
(* sintáctico y el léxico deben seguirlo.                             *)


(* ---------------------------- Sintaxis ---------------------------- *)

programa    ::= "def" "main" "(" ")" ":" bloque "main" "(" ")" NEWLINE
bloque      ::= NEWLINE INDENT sentencia { sentencia } DEDENT
sentencia   ::= asignacion | si | para | imprimir

asignacion  ::= ID "=" expr NEWLINE
imprimir    ::= "print" "(" expr ")" NEWLINE
si          ::= "if" condicion ":" bloque [ "else" ":" bloque ]
para        ::= "for" ID "in" "range" "(" expr [ "," expr ] ")" ":" bloque

condicion   ::= expr OPREL expr
expr        ::= termino { ( "+" | "-" ) termino }
termino     ::= factor { ( "*" | "//" | "%" ) factor }
factor      ::= NUM | ID | "(" expr ")" | "-" factor


(* ----------------------------- Léxico ----------------------------- *)

ID              ::= ( letra | "_" ) { letra | digito | "_" }    (* excepto palabras reservadas *)
NUM             ::= "0" { "0" } | digito_no_cero { digito }
OPREL           ::= "==" | "!=" | "<" | "<=" | ">" | ">="

letra           ::= "a" | ... | "z" | "A" | ... | "Z"           (* solo ASCII: sin acentos ni ñ *)
digito          ::= "0" | digito_no_cero
digito_no_cero  ::= "1" | ... | "9"

(* Palabras reservadas: def main if else for in range print           *)
(* El léxico toma siempre el lexema más largo posible: <= es un solo  *)
(* token y no < seguido de =, e ifx es un ID y no if seguido de x. Un *)
(* lexema es palabra reservada solo si coincide completo con una.     *)
(* El léxico genera NEWLINE, INDENT y DEDENT a partir de los fines de *)
(* línea y de la sangría (con una pila de niveles).                   *)
(* Espacios y tabuladores separan tokens; la sangría solo admite      *)
(* espacios.                                                          *)
(* Comentarios: de # al fin de la línea; el léxico los descarta.      *)
